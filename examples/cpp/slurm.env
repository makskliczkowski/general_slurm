# Defaults of this project on every cluster. Cluster values (partition, modules) and the project's own variable SIM_SCRATCH live in
# ~/.config/general_slurm/, one value per cluster. GS_REQUIRED makes gs doctor fail while SIM_SCRATCH is empty.
# -----------------------------------------------
# Author            : Maks Kliczkowski
# File              : slurm.env
# -----------------------------------------------
GS_PROJECT=example_cpp
GS_REQUIRED=SIM_SCRATCH
GS_COMMAND=./build/sim {} --out {SIM_SCRATCH}

# -------------------------------------------
#! EOF
# -------------------------------------------
