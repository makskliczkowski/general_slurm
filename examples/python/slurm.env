# Defaults of this project on every cluster. Cluster values (partition, modules, virtualenv) and the project's own variable FIT_SCRATCH live
# in ~/.config/general_slurm/, one value per cluster. GS_REQUIRED makes gs doctor fail while FIT_SCRATCH is empty.
# -----------------------------------------------
# Author            : Maks Kliczkowski
# File              : slurm.env
# -----------------------------------------------
GS_PROJECT=example_python
GS_REQUIRED=FIT_SCRATCH
GS_COMMAND={GS_PYTHON} scripts/run.py {} --out {FIT_SCRATCH}

# -------------------------------------------
#! EOF
# -------------------------------------------
