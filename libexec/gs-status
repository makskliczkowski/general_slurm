#!/usr/bin/env bash
# Count the tasks of jobs by state: of one job, of the jobs of a run folder, or of the jobs whose name starts with a prefix.
#
# usage: gs status JOBID|RUN_FOLDER|PREFIX [--since TIME]
# example: gs status runs/<run> --since now-2days
# A run folder selects the jobs named "<folder name>_...", the names gs table gives. The counts come from sacct, one line per job name and
# state; a pending array range counts as its number of tasks, and a requeued task counts once, in its last state.
# -----------------------------------------------
# Author            : Maks Kliczkowski
# File              : gs-status
# -----------------------------------------------
set -euo pipefail
source "${GS_HOME}/lib/gs.sh"

# ---- arguments ----
gs_positional TARGET "a job id, a run folder or a job-name prefix"
gs_option --since SINCE now-7days "jobs that started since then, for a folder or a prefix (sacct --starttime)"
gs_parse "$@"

PREFIX=""
if [[ "${TARGET}" =~ ^[0-9]+$ ]]; then
    SELECT=(--jobs "${TARGET}")
else
    SELECT=(--user "${USER}" --starttime "${SINCE}")
    PREFIX="${TARGET}"
    if [[ -d "${TARGET}" ]]; then
        PREFIX="$(basename "$(cd "${TARGET}" && pwd)")_"
    fi
fi

# ---- counts by job name and state ----
sacct --allocations --noheader --parsable2 --format=JobID,JobName,State "${SELECT[@]}" | awk -F'|' -v prefix="${PREFIX}" '
    # the number of tasks of a job id: 1, or the size of a pending range such as 123_[0-4,7%2]
    function tasks(id,    range, parts, ends, count, total, i) {
        if (id !~ /_\[/) {
            return 1
        }
        range = id
        sub(/.*_\[/, "", range)
        sub(/[]%].*/, "", range)
        count = split(range, parts, ",")
        total = 0
        for (i = 1; i <= count; i++) {
            if (split(parts[i], ends, "-") == 2) {
                total += ends[2] - ends[1] + 1
            } else {
                total += 1
            }
        }
        return total
    }
    prefix == "" || index($2, prefix) == 1 {
        # "CANCELLED by 123" counts as CANCELLED
        split($3, state, " ")
        count[$2 "\t" state[1]] += tasks($1)
    }
    END {
        for (key in count) {
            split(key, part, "\t")
            printf "%-48s %-14s %d\n", part[1], part[2], count[key]
        }
    }
' | sort

# -------------------------------------------
#! EOF
# -------------------------------------------
